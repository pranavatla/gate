gate.atla.in {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	@hidden path /docs* /redoc* /openapi.json
	respond @hidden 404

	reverse_proxy gateway:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output stdout
		format json
	}
}

